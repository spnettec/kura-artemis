Manifest-Version: 1.0
Bundle-ManifestVersion: 2
Bundle-Name: Artemis Broker for Eclipse Kura
Bundle-SymbolicName: org.eclipse.kura.broker.artemis.core
Bundle-Version: 2.0.0.qualifier
Bundle-Vendor: Eclipse Kura
Bundle-License: Eclipse Public License v2.0
Bundle-ActivationPolicy: lazy
Require-Capability: osgi.extender;filter:="(osgi.extender=osgi.serviceloader.registrar)",
 osgi.ee;filter:="(&(osgi.ee=JavaSE)(version=17))"
Import-Package: org.eclipse.kura.configuration;version="[1.1,3.0)",
 org.apache.commons.beanutils,
 org.apache.commons.beanutils.expression,
 org.apache.qpid.proton.amqp,
 org.apache.qpid.proton.amqp.messaging,
 org.apache.qpid.proton.amqp.transaction,
 org.apache.qpid.proton.amqp.transport,
 org.apache.qpid.proton.codec,
 org.apache.qpid.proton.engine,
 org.apache.qpid.proton.message,
 org.apache.qpid.proton.message.impl,
 org.osgi.framework;version="[1.8,2)",
 org.osgi.util.tracker;version="[1.5,2)",
 org.slf4j;version="[1.7,3)",
 io.netty.buffer;version="[4.1,5)",
 io.netty.bootstrap;version="[4.1,5)",
 io.netty.channel;version="[4.1,5)",
 io.netty.channel.epoll;version="[4.1,5)",
 io.netty.channel.group;version="[4.1,5)",
 io.netty.channel.kqueue;version="[4.1,5)",
 io.netty.channel.local;version="[4.1,5)",
 io.netty.channel.nio;version="[4.1,5)",
 io.netty.channel.socket.nio;version="[4.1,5)",
 io.netty.handler.codec;version="[4.1,5)",
 io.netty.handler.codec.base64;version="[4.1,5)",
 io.netty.handler.codec.http;version="[4.1,5)",
 io.netty.handler.codec.http.cookie;version="[4.1,5)",
 io.netty.handler.codec.http.websocketx;version="[4.1,5)",
 io.netty.handler.codec.socksx;version="[4.1,5)",
 io.netty.handler.proxy;version="[4.1,5)",
 io.netty.handler.ssl;version="[4.1,5)",
 io.netty.handler.ssl.util;version="[4.1,5)",
 io.netty.resolver;version="[4.1,5)",
 io.netty.util;version="[4.1,5)",
 io.netty.util.collection;version="[4.1,5)",
 io.netty.util.concurrent;version="[4.1,5)",
 io.netty.util.internal;version="[4.1,5)",
 io.netty.handler.codec.mqtt;version="[4.1,5)",
 org.apache.commons.collections;version="[3.2,4)"
Bundle-ClassPath: .,
 artemis-server.jar,
 artemis-commons.jar,
 artemis-core-client.jar,
 artemis-jdbc-store.jar,
 artemis-jms-client.jar,
 artemis-jms-server.jar,
 artemis-journal.jar,
 artemis-selector.jar,
 artemis-service-extensions.jar,
 artemis-mqtt-protocol.jar,
 artemis-amqp-protocol.jar,
 artemis-stomp-protocol.jar,
 activemq-artemis-native.jar,
 artemis-log-annotation-processor.jar,
 jctools-core.jar,
 caffeine.jar
Export-Package: org.eclipse.kura.broker.artemis.core
DynamicImport-Package: *
Provide-Capability: osgi.serviceloader;osgi.serviceloader=org.apache.activemq.artemis.spi.core.protocol.ProtocolManagerFactory
